# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
# Issue data is persisted via `bd dolt push`; git tracking is redundant noise
.beads/issues.jsonl
# Same for the interaction/audit log: every `bd close` appends a row, nothing
# stages it, and closes referencing a commit hash necessarily happen after that
# commit — so it was permanently dirty. The rows live in Dolt (`bd show` renders
# close reasons from the DB, not from this file).
.beads/interactions.jsonl

# Beads / Dolt files (added by bd init)
.beads/proxieddb/
